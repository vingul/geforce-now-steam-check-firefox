# Copy to .amo-credentials (gitignored) and fill in. Read by scripts/install-local.*
# One KEY=value per line, no quotes, no spaces around "=".

# AMO API credentials for `sign`: https://addons.mozilla.org/developers/addon/api/key/
WEB_EXT_API_KEY=user:12345678:123
WEB_EXT_API_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Your own add-on id: the stock one belongs to the upstream author's AMO listing.
ADDON_ID=gfn-check-fork@yourname

# Bump on every re-sign of a changed build: AMO signs a given version only once.
ADDON_VERSION=1.0.1
